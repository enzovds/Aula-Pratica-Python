# Configurações da Aplicação
# Copie este arquivo para .env e ajuste conforme necessário

# ===========================
# ViaCEP API (Validação de CEP)
# ===========================
VIACEP_API_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT=5

# ===========================
# G1 Web Scraping
# ===========================
G1_URL=https://g1.globo.com/
G1_TIMEOUT=5
G1_SELECTOR=feed-post-link
G1_MAX_POSTS=5

# ===========================
# Banco de Dados SQLite
# ===========================
# Nome do arquivo do banco de dados
DATABASE_NAME=noticias.db

# Número de dias para manter dados no banco (política de retenção)
DATABASE_RETENTION_DAYS=7

# Intervalo em segundos para verificar dados antigos
DATABASE_CHECK_INTERVAL=86400

# ===========================
# Configurações do Sistema
# ===========================
# Intervalo de varredura em segundos (quanto tempo entre cada coleta)
INTERVALO_VARREDURA=30

# User-Agent para requisições HTTP
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ===========================
# Logging (Registro de Eventos)
# ===========================
# Nome do arquivo de log
LOG_FILE=sistema_monitoramento.log

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Tamanho máximo do arquivo de log em bytes (5MB = 5242880)
LOG_MAX_BYTES=5242880

# Número de arquivos de backup de log a manter
LOG_BACKUP_COUNT=5

# ===========================
# Debug e Verbose
# ===========================
# Ativar modo debug (true/false)
DEBUG_MODE=false

# Ativar saída verbosa no console (true/false)
VERBOSE=false
